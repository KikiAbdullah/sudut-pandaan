# --- Halaman detail: URL kanonik tanpa .html (dipakai canonical + sitemap) ----
# Ditulis eksplisit supaya tidak bergantung pada fitur "Pretty URLs" hosting.
/berita/:slug      /berita/:slug.html      200
/wisata/:slug      /wisata/:slug.html      200
/kuliner/:slug     /kuliner/:slug.html     200
/umkm/:slug        /umkm/:slug.html        200
/panduan/:slug     /panduan/:slug.html     200

# --- Pola lama /berita/detail.html?slug=… → halaman statis (301 permanen) -----
# Netlify/Cloudflare tidak bisa membaca query string di aturan redirect, jadi
# jembatan JS di /berita/detail.html yang menanganinya (noindex, aman).
# Di Apache, .htaccess sudah menangani ini dengan 301 sungguhan.

# Halaman detail lain yang aman dipetakan otomatis (dilayani berkas .html)
# sudah tercakup aturan :slug di atas; sisa URL gaya Laravel (/berita/slug/edit,
# /api/…) sengaja dibiarkan 404 agar tidak menyesatkan crawler.
